# Server
PORT=3000

# Database
# When using Docker Compose, DB_HOST must be set to "db" (the service name)
DB_HOST=db
DB_PORT=3306
DB_NAME=grocery_app
DB_USER=grocery_user
DB_PASSWORD=your_db_password_here
DB_ROOT_PASSWORD=your_db_root_password_here

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
